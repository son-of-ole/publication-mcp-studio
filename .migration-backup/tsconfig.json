{
  "compilerOptions": {
    "target": "ES2017",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": ["./src/*"],
      "@publication-mcp-studio/client": ["./packages/publication-client/src/index.ts"],
      "@publication-mcp-studio/platform": ["./packages/publication-platform/src/index.ts"],
      "@publication-mcp-studio/platform/*": ["./packages/publication-platform/src/*"],
      "@publication-platform": ["./packages/publication-platform/src/index.ts"],
      "@publication-platform/*": ["./packages/publication-platform/src/*"]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts",
    "**/*.mts"
  ],
  "exclude": [
    "node_modules",
    "Verifiable-Video-Manifest-Protocol",
    ".publication-mcp-studio",
    "templates",
    "packages/*/dist"
  ]
}
