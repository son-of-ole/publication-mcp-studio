# Engine-only example. Copy privately; never put engine variables in website env.
NODE_ENV=production
PORT=8080
HOST=127.0.0.1
PUBLICATION_FEED_PORT=8081
PUBLICATION_FEED_HOST=127.0.0.1
PUBLICATION_ENGINE_ORIGIN=https://engine.example.com
PUBLICATION_ADMIN_ORIGIN=https://engine.example.com
PUBLICATION_PLATFORM_ADAPTER=neon
NEON_DATABASE_URL=
PUBLICATION_API_SECRET=
PUBLICATION_ADMIN_EMAIL=
PUBLICATION_ADMIN_PASSWORD=
# Supabase deployments require verified immutable user IDs, never user metadata.
PUBLICATION_ADMIN_USER_IDS=
# Optional engine generation; external AI clients can draft through MCP without it.
OPENROUTER_API_KEY=
PUBLICATION_AGENT_MODEL=openai/gpt-5-mini
PUBLICATION_AGENT_ALLOWED_MODELS=openai/gpt-5-mini
