{
  "name": "@publication-mcp-studio/platform",
  "version": "0.1.1",
  "type": "module",
  "description": "Stack-agnostic publication platform adapters and contracts for Publication MCP Studio integrations.",
  "license": "MIT",
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup src/index.ts src/local.ts src/neon.ts src/supabase.ts src/template.ts src/types.ts src/errors.ts src/media-storage.ts src/token-scopes.ts --format esm --dts --clean",
    "test": "tsx --test test/**/*.test.ts",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1033.0",
    "@neondatabase/serverless": "^1.1.0",
    "@supabase/supabase-js": "^2.87.1"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./types": {
      "types": "./dist/types.d.ts",
      "import": "./dist/types.js"
    },
    "./errors": {
      "types": "./dist/errors.d.ts",
      "import": "./dist/errors.js"
    },
    "./media-storage": {
      "types": "./dist/media-storage.d.ts",
      "import": "./dist/media-storage.js"
    },
    "./token-scopes": {
      "types": "./dist/token-scopes.d.ts",
      "import": "./dist/token-scopes.js"
    },
    "./local": {
      "types": "./dist/local.d.ts",
      "import": "./dist/local.js"
    },
    "./neon": {
      "types": "./dist/neon.d.ts",
      "import": "./dist/neon.js"
    },
    "./supabase": {
      "types": "./dist/supabase.d.ts",
      "import": "./dist/supabase.js"
    },
    "./template": {
      "types": "./dist/template.d.ts",
      "import": "./dist/template.js"
    }
  }
}
