{
  "name": "@publication-mcp-studio/client",
  "version": "0.1.1",
  "type": "module",
  "description": "Client SDK for integrating external apps with a hosted Publication MCP Studio deployment.",
  "license": "MIT",
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup src/index.ts --format esm --dts --clean",
    "prepublishOnly": "npm run build"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  }
}
