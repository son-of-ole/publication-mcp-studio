{
  "name": "@publication-mcp-studio/client",
  "version": "0.3.2",
  "type": "module",
  "description": "Client SDK for integrating external apps with a hosted Publication MCP Studio deployment.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/son-of-ole/publication-mcp-studio.git",
    "directory": "packages/publication-client"
  },
  "keywords": [
    "publication",
    "mcp",
    "client",
    "sdk"
  ],
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md"
  ],
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup src/index.ts --format esm --dts --clean --sourcemap",
    "dev": "tsup src/index.ts --format esm --dts --sourcemap --watch",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "prepublishOnly": "pnpm run build"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "tsup": "^8.3.0",
    "typescript": "^5.6.0"
  }
}
