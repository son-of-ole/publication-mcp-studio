modules = ["nodejs-24", "python-3.11"]

[deployment]
router = "application"
deploymentTarget = "autoscale"

[deployment.postBuild]
args = ["pnpm", "store", "prune"]
env = { "CI" = "true" }

[workflows]
runButton = "Project"

[agent]
stack = "PNPM_WORKSPACE"
expertMode = true

[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 20000

# Only the reader website is exposed. Deploy the MCP engine on its own secured origin.
[[ports]]
localPort = 19344
externalPort = 80

[userenv]

[userenv.shared]
# The reader website needs only PUBLICATION_SITE_URL and PUBLICATION_PUBLISHED_ORIGIN.
# Configure engine credentials only in the separately deployed engine environment.
