# Copy this file to .env.local and fill in values.
# Never commit .env.local.

# Supabase (optional in local mode, required for shared production persistence)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Neon / Postgres (optional; used by the Neon publication adapter)
NEON_DATABASE_URL=
DATABASE_URL=
POSTGRES_URL=

# Shared publication media storage (optional; if omitted, local filesystem media is used)
PUBLICATION_MEDIA_DRIVER=
PUBLICATION_MEDIA_S3_BUCKET=
PUBLICATION_MEDIA_S3_REGION=
PUBLICATION_MEDIA_S3_ENDPOINT=
PUBLICATION_MEDIA_S3_ACCESS_KEY_ID=
PUBLICATION_MEDIA_S3_SECRET_ACCESS_KEY=
PUBLICATION_MEDIA_S3_SESSION_TOKEN=
PUBLICATION_MEDIA_PUBLIC_BASE_URL=
PUBLICATION_MEDIA_PREFIX=
PUBLICATION_MEDIA_S3_FORCE_PATH_STYLE=

# OpenRouter (optional; used by the publication drafting agent)
OPENROUTER_API_KEY=
NEXT_PUBLIC_OPENROUTER_API_KEY=

# Publication API / MCP auth
# In local adapter mode, signed tokens can fall back to a local development secret.
# Set PUBLICATION_API_SECRET explicitly before production use.
PUBLICATION_API_TOKEN=
PUBLICATION_API_SECRET=
PUBLICATION_API_SECRETS=
PUBLICATION_PLATFORM_ADAPTER=
PUBLICATION_LOCAL_ROOT_DIR=
PUBLICATION_LOCAL_SEED_DEMO_CONTENT=
PUBLICATION_ADMIN_EMAIL=
PUBLICATION_ADMIN_PASSWORD=
PUBLICATION_AGENT_MODEL=
NEXT_PUBLIC_SITE_URL=

# Image generation model (optional)
NEXT_PUBLIC_IMAGE_MODEL=
