# Copy this file to .env.local and fill in values.
# Never commit .env.local.

# Supabase (required for leaderboard / run storage)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# OpenRouter (optional; used by the publication drafting agent)
OPENROUTER_API_KEY=
NEXT_PUBLIC_OPENROUTER_API_KEY=

# Publication API / MCP auth
PUBLICATION_API_TOKEN=
PUBLICATION_API_SECRET=
PUBLICATION_API_SECRETS=
PUBLICATION_AGENT_MODEL=
NEXT_PUBLIC_SITE_URL=

# Image generation model (optional)
NEXT_PUBLIC_IMAGE_MODEL=
